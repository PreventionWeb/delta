# Copy this file to .env.playwright before running `yarn test:e2e`.
#
# Dedicated PostgreSQL connection URL for Playwright E2E tests.
# IMPORTANT:
# - Never point this at your live or local development database.
# - The database name MUST end with `_test`, `_e2e`, or `_playwright`
#   (global.setup.ts drops and recreates this database on every E2E run).
PLAYWRIGHT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/delta_e2e"
