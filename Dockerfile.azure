# Use a smaller official Node.js base image
FROM node:24-bookworm-slim AS builder

# Set the working directory to /delta
WORKDIR /delta

# Copy dependency manifests
COPY package.json yarn.lock ./

# Install ALL dependencies (needed for build step)
RUN HUSKY=0 yarn install --frozen-lockfile \
	&& yarn cache clean

# Copy the rest of the application code to the working directory
COPY . .

# Build the application (React Router build + binary)
RUN yarn build:binary:linux

# ============================================================================
# Production stage: lean runtime image with only production dependencies
# ============================================================================
FROM node:24-bookworm-slim AS production

WORKDIR /delta

# Install PostgreSQL client (psql), plus Supervisor and OpenSSH server for Azure Web SSH
RUN apt-get update \
	&& apt-get install -y --no-install-recommends postgresql-client supervisor openssh-server \
	&& rm -rf /var/lib/apt/lists/*

# Copy dependency manifests
COPY package.json yarn.lock ./

# Install runtime dependencies only
RUN HUSKY=0 yarn install --frozen-lockfile --production \
	&& yarn cache clean

# Copy all contents from dts_shared_binary into /delta (including dotfiles)
COPY --from=builder /delta/dts_shared_binary/. ./

# Copy database initialization script
COPY ./scripts/dts_database/database_init_docker_prod.sql ./dts_database/

# Azure Web SSH: App Service connects to sshd on port 2222 as root with the
# fixed password "Docker!" (required by App Service; only reachable through its tunnel)
RUN echo "root:Docker!" | chpasswd \
	&& ssh-keygen -A \
	&& mkdir -p /var/run/sshd
COPY ./scripts/azure/sshd_config /etc/ssh/sshd_config

# Supervisor runs the app and sshd; the entrypoint initialises the database first
COPY ./scripts/azure/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY ./scripts/azure/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose the port that the application will use, and the Azure Web SSH port
EXPOSE 3000 2222

# Set the environment variables (production image)
ENV NODE_ENV=production
ENV PORT=3000

# Run migrations, then start the app and sshd under Supervisor
CMD ["/entrypoint.sh"]
