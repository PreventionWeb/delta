{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "yarn",
	"testRunner": "vitest",
	"checkers": ["typescript"],
	"coverageAnalysis": "perTest",
	"mutate": ["app/domains/**/*.ts", "!app/domains/**/*.test.ts"],
	"reporters": ["progress", "clear-text", "html"],
	"thresholds": {
		"high": 90,
		"low": 75,
		"break": 75
	}
}
